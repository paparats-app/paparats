{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, and only what its UI calls: the app's own commands (app_commands.rs, one allow-<command> each), typed events, the frameless window chrome, links in the default browser, the settings store, start on login and the update check. Rust-only plugins (window-state, single-instance, deep-link) need nothing here.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:resources:allow-close",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "store:allow-load",
    "store:allow-entries",
    "store:allow-set",
    "store:allow-save",
    "store:allow-reload",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:allow-check",
    "allow-app-info",
    "allow-catalog-get-catalog",
    "allow-catalog-get-platform",
    "allow-install-get-library",
    "allow-install-set-favorite",
    "allow-install-uninstall",
    "allow-install-open",
    "allow-install-open-folder",
    "allow-downloads-snapshot",
    "allow-downloads-enqueue",
    "allow-downloads-pause",
    "allow-downloads-resume",
    "allow-downloads-cancel",
    "allow-downloads-pause-all",
    "allow-downloads-resume-all",
    "allow-downloads-cancel-all",
    "allow-downloads-set-concurrency",
    "allow-downloads-set-online",
    "allow-channels-get-channels",
    "allow-channels-get-subscriptions",
    "allow-channels-lookup",
    "allow-channels-subscribe",
    "allow-channels-unsubscribe",
    "allow-channels-set-paused",
    "allow-channels-acknowledge-stale",
    "allow-channels-sync",
    "allow-channels-report",
    "allow-ideas-get",
    "allow-ideas-vote",
    "allow-ideas-propose",
    "allow-ideas-comment",
    "allow-ideas-take",
    "allow-ideas-release",
    "allow-ideas-dismiss-release-note",
    "allow-account-get",
    "allow-account-update-profile",
    "allow-account-remove-device",
    "allow-account-set-two-factor",
    "allow-account-purchase",
    "allow-account-cancel-plan",
    "allow-account-claim-idea-bonus",
    "allow-account-sign-in",
    "allow-account-sign-out",
    "allow-system-today",
    "allow-shell-set-locale",
    "allow-shell-set-minimize-to-tray",
    "allow-shell-window-ready",
    "allow-shell-take-deep-links"
  ]
}
