{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paparats",
  "version": "0.1.0",
  "identifier": "com.paparats.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paparats",
        "width": 1440,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b171b",
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: data: blob: https://paparats-app.github.io",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["paparats"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/paparats-app/paparats/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNENCRUE3RkU2QkUxOTkKUldTWjRXditwNzVNRVVGNVZJcU9XcklUNm1ZYmh0K0s5MEdmNWYzeXRFV3FGWGFBM0hNL0ErNlkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Paparats",
    "category": "Utility",
    "shortDescription": "Curated app store for Windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "signCommand": {
        "cmd": "node",
        "args": ["scripts/sign-windows.mjs", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
